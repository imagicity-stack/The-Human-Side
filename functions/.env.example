# ============================================================
# functions/.env  — NON-SECRET deploy parameters
# ------------------------------------------------------------
# Copy to functions/.env and fill in. These are read by
# defineString() params in index.js. (.env is gitignored.)
#
# SECRETS are NOT here — set them with:
#   firebase functions:secrets:set RAZORPAY_KEY_ID
#   firebase functions:secrets:set RAZORPAY_KEY_SECRET
#   firebase functions:secrets:set RAZORPAY_WEBHOOK_SECRET
#   firebase functions:secrets:set SMTP_PASS
# ============================================================

# Comma-separated front-end origins allowed to call the API.
# Leave empty to allow any origin (fine while setting up).
ALLOWED_ORIGINS=https://your-app.vercel.app

# The single email allowed into the admin dashboard.
ADMIN_EMAIL=admin@thehumanside.org

# SMTP for the welcome email (sent from contact@edenwoods.org).
SMTP_HOST=smtp.your-mail-host.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contact@edenwoods.org
MAIL_FROM=The Human Side <contact@edenwoods.org>
