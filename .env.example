# ============================================================
# The Human Side — environment variables (all set in Vercel)
# ------------------------------------------------------------
# Vercel → Project → Settings → Environment Variables.
# Copy to .env.local for local dev (this file is committed; .env.local is not).
#
# Two groups:
#   • NEXT_PUBLIC_*  → exposed to the browser (public, safe).
#   • everything else → server-only (secrets). Never prefixed NEXT_PUBLIC.
# ============================================================

# ---- Razorpay ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=a_secret_you_set_in_razorpay_webhooks
# Public key id for the browser checkout sheet (same value as RAZORPAY_KEY_ID):
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# ---- Firebase Admin (server) — from a service-account JSON ----
# Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=the-human-side
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@the-human-side.iam.gserviceaccount.com
# Paste the whole key incl. the \n sequences (code converts them to newlines):
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# Named Firestore database id:
FIRESTORE_DATABASE_ID=the-human-side

# ---- Firebase Web (browser) — used only by the admin login ----
# Firebase Console → Project settings → General → Your apps → SDK config
NEXT_PUBLIC_FIREBASE_API_KEY=AIza...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=the-human-side.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=the-human-side
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=the-human-side.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxx

# ---- Admin dashboard ----
ADMIN_EMAIL=admin@thehumanside.org

# ---- Email (welcome mail from contact@edenwoods.org) ----
SMTP_HOST=smtp.your-mail-host.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contact@edenwoods.org
SMTP_PASS=your_mailbox_or_app_password
MAIL_FROM=The Human Side <contact@edenwoods.org>
