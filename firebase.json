{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "firestore.rules",
      "README.md"
    ],
    "rewrites": [
      { "source": "/createOrder", "function": "createOrder" },
      { "source": "/verifyPayment", "function": "verifyPayment" }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
