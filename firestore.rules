rules_version = '2';

// ============================================================
// The Human Side — Firestore security rules
// ============================================================
//
// ALL data access happens server-side via the Firebase Admin SDK
// (Next.js API routes on Vercel), which BYPASSES these rules. The
// browser never reads or writes Firestore directly — its only Firebase
// use is Authentication for the admin login, which these rules don't
// govern.
//
// Therefore the correct, safest posture is to deny every direct client
// read/write to every collection (members, counters, settings, payments,
// and anything added later). A member ID, a payment record, or a fee
// change can only ever be created by the trusted server after it has
// verified the Razorpay signature / the admin's identity.
//
// NOTE: these apply to the database this deploy targets. firebase.json
// sets "database": "the-human-side", so deploy with:
//   firebase deploy --only firestore:rules
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
